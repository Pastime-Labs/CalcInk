{
  "name": "calcink",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "vite",
    "prebuild": "npm run prepare:assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "replay:fixture": "node scripts/replay-fixture.mjs",
    "test": "vitest run src && node --test scripts/replay-fixture.test.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@paddleocr/paddleocr-js": "0.4.2",
    "onnxruntime-web": "^1.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
