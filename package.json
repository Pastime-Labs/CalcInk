{
  "name": "calcink",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-paddle-decoder.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/patch-paddle-decoder.mjs --check",
    "dev": "vite",
    "prebuild": "npm run prepare:assets && node scripts/patch-paddle-decoder.mjs --check",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "replay:fixture": "node scripts/replay-fixture.mjs",
    "test": "vitest run src && node --test scripts/patch-paddle-decoder.test.mjs scripts/replay-fixture.test.mjs scripts/score-benchmark.test.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@paddleocr/paddleocr-js": "0.4.2",
    "onnxruntime-web": "^1.26.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
